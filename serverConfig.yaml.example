# 服务端配置文件示例
# 复制此文件为 serverConfig.yaml 并填写实际配置

# HTTP 请求入口端口，外部用户通过此端口访问内网服务
# 例如: http://your-server:9082/ollama/v1/chat
server_port: "9082"

# SOCKS5 客户端连接端口，客户端通过此端口建立隧道连接
# 需要在防火墙中开放此端口，允许客户端连接
socks_port: "9083"

# 认证密钥，所有客户端必须使用相同的密钥才能注册
# 用于防止未授权客户端使用隧道，建议使用强随机字符串
# 推荐生成方式: openssl rand -hex 16
auth_key: "your-secret-key-here"